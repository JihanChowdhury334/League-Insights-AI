# Copy to .env and fill in. Never commit the filled-in file.

# Riot API key from https://developer.riotgames.com/
#   - Development key: expires every 24 hours
#   - Personal key:    does not expire, but has a narrower endpoint allowance
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/league_insights

# Optional: which Riot cluster serves the global Account-V1 lookups.
# Account data is global, so this only affects latency.
# Valid for Account-V1: americas, europe, asia ('sea' is Match-V5 only).
RIOT_ACCOUNT_CLUSTER=americas

# Optional: use Account-V1's region endpoint during cluster detection.
# Off by default -- detection relies only on Match-V5, which every LoL key
# carries. Enable it to skip the cluster probe if your key grants it.
RIOT_USE_REGION_ENDPOINT=false

# Optional: AWS Bedrock, required only by /generate-recap
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
